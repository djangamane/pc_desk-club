                      <h3
                        class=""
                        style="font-size: 28px; color: rgb(232, 244, 255); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5); font-family: "Orbitron", sans-serif; font-weight: 800; background: linear-gradient(180deg, #ffffff 0%, #7cbdff 100%); -webkit-text-fill-color: transparent; letter-spacing: 2px; line-height: 1.4; margin-top: 0px; margin-bottom: 32px; text-align: left;"
                      >
