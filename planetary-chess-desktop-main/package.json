{
  "name": "planetary-chess-vite",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc --project tsconfig.desktop.json && vite build --mode desktop",
    "build:desktop-full": "node scripts/build-desktop.js",
    "build:mobile": "tsc -b && vite build --mode mobile && npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:desktop": "vite preview --outDir dist-desktop",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mobile-deps": "vitest run --reporter=verbose src/test/mobileDependencies.test.ts",
    "test:responsive": "vitest run src/test/comprehensive/responsiveTestSuite.test.ts",
    "test:integration": "vitest run src/test/integration/responsiveLayout.test.tsx",
    "test:visual": "vitest run src/test/visual/screenSizes.test.tsx",
    "test:compatibility": "vitest run src/test/compatibility/crossBrowser.test.tsx",
    "test:accessibility": "vitest run src/test/accessibility/keyboardNavigation.test.tsx",
    "test:performance": "vitest run src/test/performance/desktopRendering.test.tsx",
    "test:responsive-all": "vitest run src/test/integration/ src/test/visual/ src/test/compatibility/ src/test/accessibility/ src/test/performance/ src/test/comprehensive/",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:desktop && node scripts/build-electron.js && electron-builder",
    "electron:build:win": "npm run build:desktop && node scripts/build-electron.js && electron-builder --win",
    "electron:build:mac": "npm run build:desktop && node scripts/build-electron.js && electron-builder --mac",
    "electron:build:linux": "npm run build:desktop && node scripts/build-electron.js && electron-builder --linux",
    "electron:dist": "npm run build:desktop && node scripts/build-electron.js && electron-builder --publish=never",
    "electron:pack": "npm run build:desktop && node scripts/build-electron.js && electron-builder --dir",
    "prepare-build": "node scripts/prepare-build.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@mantine/core": "^7.16.1",
    "@mantine/hooks": "^7.16.1",
    "@supabase/supabase-js": "^2.49.3",
    "antd": "^5.27.1",
    "chess.js": "^1.4.0",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.3.1",
    "react-router": "^6.15.0",
    "react-router-dom": "^6.15.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.planetarychess.desktop",
    "productName": "Planetary Chess",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-desktop/**/*",
      "dist-electron/**/*",
      "package.json",
      {
        "from": "node_modules",
        "filter": [
          "**/*",
          "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
          "!.editorconfig",
          "!**/._*",
          "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
          "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
          "!**/{appveyor.yml,.travis.yml,circle.yml}",
          "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "${productName}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Game",
      "desktop": {
        "Name": "Planetary Chess",
        "Comment": "Strategic chess game with AI",
        "Keywords": "chess;game;strategy;ai;"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "planetary-chess",
      "repo": "planetary-chess-desktop"
    }
  }
}
