{
  "framework": "vite",
  "buildCommand": "cd planetary-chess-desktop-main && tsc -p ../tsconfig.vercel.json && vite build --config ../vite.vercel.config.ts",
  "outputDirectory": "planetary-chess-desktop-main/dist",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "github": {
    "silent": true
  }
}